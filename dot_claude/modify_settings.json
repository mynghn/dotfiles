#!/bin/sh


input=$(cat)

if [ -z "$input" ]; then
  input='{}'
fi

# jq always appends a trailing newline; Claude Code writes settings.json WITHOUT
# one, so emit no trailing newline to keep chezmoi's target == the live file.
printf '%s' "$(echo "$input" | jq '
  .statusLine = {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  } |
  .alwaysThinkingEnabled = true |
  # Opt out of built-in commit/PR instructions + git-status snapshot.
  # Static prompt reduction: ~2k tokens/session (Sonnet), ~2.6k (Opus 4.7 xhigh).
  # Measured on v2.1.117; no cache-prefix invalidation observed.
  .includeGitInstructions = false |
  .enabledPlugins["mgrep@Mixedbread-Grep"] = true |
  .hooks.PreToolUse = [{
    "matcher": "Edit|Write|MultiEdit",
    "hooks": [{"type": "command", "command": "~/.claude/hooks/chezmoi-guard.sh"}]
  }, {
    "matcher": "Bash",
    "hooks": [{"type": "command", "command": "~/.claude/hooks/gh-comment-attribution.sh", "if": "Bash(gh *)", "statusMessage": "Checking GitHub comment attribution..."}]
  }, {
    "matcher": "mcp__plugin_github_github__(add_issue_comment|add_comment_to_pending_review|add_reply_to_pull_request_comment|pull_request_review_write)",
    "hooks": [{"type": "command", "command": "~/.claude/hooks/gh-comment-attribution.sh", "statusMessage": "Checking GitHub comment attribution..."}]
  }]
')"
