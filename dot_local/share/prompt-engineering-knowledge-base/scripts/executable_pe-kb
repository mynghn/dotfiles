#!/usr/bin/env bash
# pe-kb — the canonical mutation channel for the prompt-engineering KB.
#
# Capture/refresh write the chezmoi SOURCE for the shared core, run `chezmoi
# apply`, then make exactly one git commit. Never hand-edit the deployed target
# and never run on a schedule: the store changes ONLY on explicit invocation of
# this helper (the lone write path keeps the core internally consistent).
set -euo pipefail

CORE_TARGET="$HOME/.local/share/prompt-engineering-knowledge-base"

die() { printf 'pe-kb: %s\n' "$1" >&2; exit 1; }

command -v chezmoi >/dev/null 2>&1 || die "chezmoi not found on PATH"
command -v python3 >/dev/null 2>&1 || die "python3 not found on PATH"

# Source dir for the managed core directory (resolve via chezmoi, with a
# layout fallback so a brand-new entry — not yet managed — still resolves).
core_src() {
  local s
  s="$(chezmoi source-path "$CORE_TARGET" 2>/dev/null || true)"
  if [[ -z "$s" || ! -d "$s" ]]; then
    s="$(chezmoi source-path)/dot_local/share/prompt-engineering-knowledge-base"
  fi
  [[ -d "$s" ]] || die "core source not found — run task C1 (chezmoi apply) first"
  printf '%s' "$s"
}

valid_slug() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid slug '$1' (kebab-case: a-z 0-9 -)"
}

apply_commit() {
  local src="$1" verb="$2" slug="$3" root
  chezmoi apply "$CORE_TARGET" >/dev/null
  root="$(chezmoi source-path)"
  git -C "$root" add -- "$src/knowledge/$slug.md" "$src/INDEX.md"
  git -C "$root" diff --cached --quiet && die "nothing changed for '$slug' — no commit made"
  git -C "$root" commit -q -m "pe-kb: $verb $slug"
  printf 'pe-kb: %sd %s (%s)\n' "$verb" "$slug" "$(git -C "$root" rev-parse --short HEAD)"
}

write_entry() {
  local verb="$1" slug="${2:-}"
  [[ -n "$slug" ]] || die "usage: pe-kb $verb <slug>   (entry markdown on stdin)"
  valid_slug "$slug"
  [[ -t 0 ]] && die "no entry markdown on stdin — pipe the full <slug>.md content"
  local src entry; src="$(core_src)"; entry="$src/knowledge/$slug.md"
  if [[ "$verb" == capture ]]; then
    [[ -e "$entry" ]] && die "entry '$slug' exists — use 'pe-kb refresh $slug' to supersede it"
  else
    [[ -e "$entry" ]] || die "entry '$slug' not found — use 'pe-kb capture $slug' to create it"
  fi
  local tmp; tmp="$(mktemp)"; trap 'rm -f "$tmp"' RETURN
  cat > "$tmp"                         # entry markdown from stdin (program is the heredoc below)
  mkdir -p "$src/knowledge"
  # Validate frontmatter (INV-6: sources + last_refreshed), then atomically write
  # the entry and upsert its sorted INDEX line. Nothing touches the source if
  # validation fails — no orphan/half-written entry.
  PE_SRC="$src" PE_SLUG="$slug" PE_TMP="$tmp" python3 - <<'PY'
import os, re, sys
src, slug, tmp = os.environ['PE_SRC'], os.environ['PE_SLUG'], os.environ['PE_TMP']
body = open(tmp, encoding='utf-8').read()
m = re.match(r'^---\n(.*?)\n---\n', body, re.S)
if not m:
    sys.exit("pe-kb: entry has no YAML frontmatter")
fm = m.group(1)
def field(n):
    mm = re.search(r'(?m)^%s:[ \t]*(.+?)[ \t]*$' % n, fm)
    return mm.group(1).strip() if mm else None
if field('name') != slug:
    sys.exit("pe-kb: frontmatter name '%s' != slug '%s'" % (field('name'), slug))
desc = field('description')
if not desc:
    sys.exit("pe-kb: frontmatter 'description' missing/empty")
if not field('last_refreshed'):
    sys.exit("pe-kb: frontmatter 'last_refreshed' missing (INV-6)")
if not re.search(r'(?m)^sources:', fm):
    sys.exit("pe-kb: frontmatter 'sources' missing (INV-6)")
open(os.path.join(src, 'knowledge', slug + '.md'), 'w', encoding='utf-8').write(body)
line = "- [%s](knowledge/%s.md) — %s" % (slug, slug, desc.strip('"\''))
idx = os.path.join(src, 'INDEX.md')
L = open(idx, encoding='utf-8').read().split('\n')
try:
    h = next(i for i, l in enumerate(L) if l.strip() == '## Techniques')
except StopIteration:
    sys.exit("pe-kb: INDEX.md missing '## Techniques' section")
er = re.compile(r'^- \[([a-z0-9-]+)\]\(knowledge/\1\.md\) — ')
keep, ents, seen = [], {}, False
for l in L[h + 1:]:
    mm = er.match(l)
    if mm:
        ents[mm.group(1)] = l; seen = True
    elif not seen:
        keep.append(l)
ents[slug] = line
while keep and keep[-1].strip() == '':
    keep.pop()
out = L[:h + 1] + keep + [''] + [ents[k] for k in sorted(ents)] + ['']
open(idx, 'w', encoding='utf-8').write('\n'.join(out))
PY
  apply_commit "$src" "$verb" "$slug"
}

# Delete an entry: drop its file + INDEX line, apply, one commit. The counterpart
# of capture — removal stays on the single mutation channel (e.g. when an entry is
# merged into another) instead of being hand-rolled.
remove_entry() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: pe-kb remove <slug>"
  valid_slug "$slug"
  local src entry; src="$(core_src)"; entry="$src/knowledge/$slug.md"
  [[ -e "$entry" ]] || die "entry '$slug' not found"
  rm -f "$entry"
  PE_SRC="$src" PE_SLUG="$slug" python3 - <<'PY'
import os, re
src, slug = os.environ['PE_SRC'], os.environ['PE_SLUG']
idx = os.path.join(src, 'INDEX.md')
L = open(idx, encoding='utf-8').read().split('\n')
pat = re.compile(r'^- \[%s\]\(knowledge/%s\.md\) — ' % (re.escape(slug), re.escape(slug)))
open(idx, 'w', encoding='utf-8').write('\n'.join(l for l in L if not pat.match(l)))
PY
  rm -f "$CORE_TARGET/knowledge/$slug.md"   # chezmoi won't delete an unmanaged target
  chezmoi apply "$CORE_TARGET" >/dev/null
  local root; root="$(chezmoi source-path)"
  git -C "$root" add -A -- "$src/knowledge/$slug.md" "$src/INDEX.md"
  git -C "$root" diff --cached --quiet && die "nothing changed for '$slug'"
  git -C "$root" commit -q -m "pe-kb: remove $slug"
  printf 'pe-kb: removed %s (%s)\n' "$slug" "$(git -C "$root" rev-parse --short HEAD)"
}

case "${1:-}" in
  capture) shift; write_entry capture "$@" ;;
  refresh) shift; write_entry refresh "$@" ;;
  remove)  shift; remove_entry "$@" ;;
  path)    printf 'target: %s\nsource: %s\nroot:   %s\n' "$CORE_TARGET" "$(core_src)" "$(chezmoi source-path)" ;;
  *) die "usage: pe-kb {capture|refresh} <slug>  (entry markdown on stdin)  |  pe-kb remove <slug>  |  pe-kb path" ;;
esac
